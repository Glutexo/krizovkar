{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Glutexo/krizovkar/main/src/krizovkar/schemas/krizovkar-v1.schema.json",
  "title": "Dokument Křížovkáře, verze 1",
  "description": "Datový model křížovky ve formátu Křížovkář.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "grid"
  ],
  "properties": {
    "format": {
      "description": "Jednoznačný název formátu.",
      "const": "krizovkar"
    },
    "version": {
      "description": "Hlavní verze datového modelu.",
      "const": 1
    },
    "grid": {
      "description": "Obdélníkový rozměr celé křížovkové mřížky.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "description": "Počet sloupců mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "description": "Počet řádků mřížky.",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
