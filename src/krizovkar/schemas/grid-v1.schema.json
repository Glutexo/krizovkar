{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Glutexo/krizovkar/master/src/krizovkar/schemas/grid-v1.schema.json",
  "title": "Cílová mřížka Křížovkáře, verze 1",
  "description": "Společný datový model nevyplněné nebo vyplněné mřížky s vepsanými, číselnými nebo smíšenými legendami.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "version",
    "grid"
  ],
  "properties": {
    "format": {
      "description": "Jednoznačný název formátu.",
      "const": "krizovkar"
    },
    "kind": {
      "description": "Druh dokumentu.",
      "const": "grid"
    },
    "version": {
      "description": "Hlavní verze datového modelu.",
      "const": 1
    },
    "grid": {
      "description": "Obdélníkový rozměr celé křížovkové mřížky.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "description": "Počet sloupců mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "description": "Počet řádků mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "description": "Volitelná matice buněk v pořadí řádků shora dolů.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/gridCell"
            }
          }
        }
      }
    },
    "clues": {
      "description": "Volitelné očíslované legendy uvedené vně mřížky; mohou se kombinovat s legendovými buňkami.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/externalClue"
      }
    },
    "secret_prompts": {
      "description": "Volitelná zadání tajenek zobrazená nad nebo pod mřížkou.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/secretPrompt"
      }
    }
  },
  "$defs": {
    "externalClue": {
      "description": "Jedna vnější legenda přiřazená číslu a směru slova.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "direction",
        "text"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "direction": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "secretPrompt": {
      "description": "Text zadání tajenky a jeho umístění vůči mřížce.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "placement": {
          "enum": [
            "above",
            "below"
          ],
          "default": "above"
        },
        "alignment": {
          "enum": [
            "left",
            "right"
          ],
          "default": "left"
        }
      }
    },
    "gridCell": {
      "description": "Běžná, tajenková, legendová, nevyplňovaná nebo pomocná buňka s volitelně již známým obsahem.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "letter",
            "secret",
            "legend",
            "empty",
            "help"
          ]
        },
        "value": {
          "description": "Volitelná již známá hodnota písmenné buňky.",
          "type": "string",
          "pattern": "^(?:CH|[A-ZÁÄČĎÉĚÍŇÓÔÖŘŠŤÚŮÜÝŽ])$"
        },
        "number": {
          "description": "Volitelné číslo začátku jednoho nebo dvou slov.",
          "type": "integer",
          "minimum": 1
        },
        "bars": {
          "description": "Silné mezislovní předěly na pravé nebo dolní hraně buňky.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "right",
              "bottom"
            ]
          }
        },
        "arrow": {
          "description": "Volitelný směr plného zobáčku tajenkové buňky.",
          "enum": [
            "up",
            "right",
            "down",
            "left"
          ]
        },
        "texts": {
          "description": "Volitelné texty legendové buňky; null rezervuje dosud nevyplněnou část.",
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "arrows": {
          "description": "Volitelné směrové šipky přiřazené postupně k textům legendy.",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "right",
              "down"
            ]
          }
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "dependentRequired": {
        "arrows": [
          "texts"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "letter"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "arrow"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "letter",
                  "secret"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "texts"
                  ]
                },
                {
                  "required": [
                    "words"
                  ]
                },
                {
                  "required": [
                    "arrows"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "legend"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "words"
                  ]
                },
                {
                  "required": [
                    "arrow"
                  ]
                },
                {
                  "required": [
                    "number"
                  ]
                },
                {
                  "required": [
                    "bars"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "empty"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "texts"
                  ]
                },
                {
                  "required": [
                    "words"
                  ]
                },
                {
                  "required": [
                    "arrows"
                  ]
                },
                {
                  "required": [
                    "arrow"
                  ]
                },
                {
                  "required": [
                    "number"
                  ]
                },
                {
                  "required": [
                    "bars"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "help"
              }
            }
          },
          "then": {
            "required": [
              "words"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "texts"
                  ]
                },
                {
                  "required": [
                    "arrows"
                  ]
                },
                {
                  "required": [
                    "arrow"
                  ]
                },
                {
                  "required": [
                    "number"
                  ]
                },
                {
                  "required": [
                    "bars"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
