{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Glutexo/krizovkar/main/src/krizovkar/schemas/grid-v1.schema.json",
  "title": "Cílová mřížka Křížovkáře, verze 1",
  "description": "Datový model výsledné křížovkové mřížky.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "version",
    "grid"
  ],
  "properties": {
    "format": {
      "description": "Jednoznačný název formátu.",
      "const": "krizovkar"
    },
    "kind": {
      "description": "Druh dokumentu.",
      "const": "grid"
    },
    "version": {
      "description": "Hlavní verze datového modelu.",
      "const": 1
    },
    "grid": {
      "description": "Obdélníkový rozměr celé křížovkové mřížky.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "description": "Počet sloupců mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "description": "Počet řádků mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "description": "Volitelná matice buněk v pořadí řádků shora dolů.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/gridCell"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gridCell": {
      "description": "Běžná nebo tajenková buňka obsahující jedno velké písmeno.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "letter",
            "secret"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Z]$"
        }
      }
    }
  }
}
