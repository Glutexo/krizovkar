{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Glutexo/krizovkar/master/src/krizovkar/schemas/grid-v1.schema.json",
  "title": "Cílová mřížka Křížovkáře, verze 1",
  "description": "Datový model výsledné křížovkové mřížky.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "version",
    "grid"
  ],
  "properties": {
    "format": {
      "description": "Jednoznačný název formátu.",
      "const": "krizovkar"
    },
    "kind": {
      "description": "Druh dokumentu.",
      "const": "grid"
    },
    "version": {
      "description": "Hlavní verze datového modelu.",
      "const": 1
    },
    "grid": {
      "description": "Obdélníkový rozměr celé křížovkové mřížky.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "description": "Počet sloupců mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "description": "Počet řádků mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "description": "Volitelná matice buněk v pořadí řádků shora dolů.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/gridCell"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gridCell": {
      "description": "Běžná, tajenková, legendová, nevyplňovaná nebo pomocná buňka.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "letter",
            "secret",
            "legend",
            "empty",
            "help"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^(?:CH|[A-ZÁÄČĎÉĚÍŇÓÔÖŘŠŤÚŮÜÝŽ])$"
        },
        "texts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "arrows": {
          "description": "Volitelné směrové šipky přiřazené postupně k textům legendy.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "right",
              "down"
            ]
          }
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "letter",
                  "secret"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "texts"
                  ]
                },
                {
                  "required": [
                    "words"
                  ]
                },
                {
                  "required": [
                    "arrows"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "legend"
              }
            }
          },
          "then": {
            "required": [
              "texts"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "words"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "empty"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "texts"
                  ]
                },
                {
                  "required": [
                    "words"
                  ]
                },
                {
                  "required": [
                    "arrows"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "help"
              }
            }
          },
          "then": {
            "required": [
              "words"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "texts"
                  ]
                },
                {
                  "required": [
                    "arrows"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
