{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Glutexo/krizovkar/master/src/krizovkar/schemas/specification-v1.schema.json",
  "title": "Zadání křížovky Křížovkáře, verze 1",
  "description": "Datový model vstupního zadání, ze kterého vznikne cílová mřížka.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "version"
  ],
  "properties": {
    "format": {
      "description": "Jednoznačný název formátu.",
      "const": "krizovkar"
    },
    "kind": {
      "description": "Druh dokumentu.",
      "const": "specification"
    },
    "version": {
      "description": "Hlavní verze datového modelu zadání.",
      "const": 1
    },
    "grid": {
      "description": "Rozměr cílové mřížky.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "description": "Počet sloupců mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "description": "Počet řádků mřížky.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "words": {
      "description": "Slova umístěná v mřížce.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/placedWord"
      }
    },
    "help": {
      "description": "Volitelné přepsání automatické polohy pomůcky.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/coordinate"
        }
      }
    }
  },
  "dependentRequired": {
    "grid": [
      "words"
    ],
    "words": [
      "grid"
    ],
    "help": [
      "grid",
      "words"
    ]
  },
  "$defs": {
    "coordinate": {
      "description": "Souřadnice počítaná od 1 z levého horního rohu.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "column"
      ],
      "properties": {
        "row": {
          "description": "Řádek počítaný odshora.",
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "description": "Sloupec počítaný zleva.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "placedWord": {
      "description": "Slovo s polohou, směrem a legendou.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "start",
        "direction",
        "legend"
      ],
      "properties": {
        "answer": {
          "description": "Přesná posloupnost písmen v mřížce.",
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "start": {
          "description": "Souřadnice prvního písmene.",
          "$ref": "#/$defs/coordinate"
        },
        "direction": {
          "description": "Směr slova od prvního písmene.",
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "legend": {
          "description": "Neprázdný text legendy slova.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "in_help": {
          "description": "Zda se odpověď vypíše v pomocné buňce.",
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
