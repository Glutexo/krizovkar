{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Glutexo/krizovkar/master/src/krizovkar/schemas/specification-v1.schema.json",
  "title": "Zadání křížovky Křížovkáře, verze 1",
  "description": "Společný datový model vstupního zadání pro švédské, čárkované i smíšené rozložení.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "version"
  ],
  "properties": {
    "format": {
      "description": "Jednoznačný název formátu.",
      "const": "krizovkar"
    },
    "kind": {
      "description": "Druh dokumentu.",
      "const": "specification"
    },
    "version": {
      "description": "Hlavní verze datového modelu zadání.",
      "const": 1
    },
    "grid": {
      "description": "Rozměr cílové mřížky.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "description": "Počet sloupců mřížky.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "description": "Počet řádků mřížky.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "words": {
      "description": "Slova umístěná v mřížce.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/placedWord"
      }
    },
    "secrets": {
      "description": "Tajenky určené buňkami, slovem nebo více bloky.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/secret"
      }
    },
    "help": {
      "description": "Volitelné přepsání automatické polohy pomůcky.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/coordinate"
        }
      }
    }
  },
  "dependentRequired": {
    "words": [
      "grid"
    ],
    "secrets": [
      "grid"
    ],
    "help": [
      "grid",
      "words"
    ]
  },
  "dependentSchemas": {
    "grid": {
      "anyOf": [
        {
          "required": [
            "words"
          ]
        },
        {
          "required": [
            "secrets"
          ]
        }
      ]
    }
  },
  "$defs": {
    "coordinate": {
      "description": "Souřadnice počítaná od 1 z levého horního rohu.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "column"
      ],
      "properties": {
        "row": {
          "description": "Řádek počítaný odshora.",
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "description": "Sloupec počítaný zleva.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "placedWord": {
      "description": "Slovo s polohou, směrem a legendou nezávisle na způsobu jejího budoucího umístění.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "start",
        "direction",
        "legend"
      ],
      "properties": {
        "answer": {
          "description": "Přesná posloupnost písmen v mřížce.",
          "type": "string",
          "pattern": "^[A-ZÁÄČĎÉĚÍŇÓÔÖŘŠŤÚŮÜÝŽ]+$"
        },
        "start": {
          "description": "Souřadnice prvního písmene.",
          "$ref": "#/$defs/coordinate"
        },
        "direction": {
          "description": "Směr slova od prvního písmene.",
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "legend": {
          "description": "Neprázdný text legendy slova.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "in_help": {
          "description": "Zda se odpověď vypíše v pomocné buňce.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "secret": {
      "description": "Tajenka jako buňky, umístěné slovo nebo více bloků.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "description": "Způsob určení tajenky.",
          "enum": [
            "cells",
            "word",
            "parts"
          ]
        },
        "cells": {
          "description": "Buňky tajenky v pořadí čtení.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "arrows": {
          "description": "Zda se vyznačí začátek a změny směru cesty.",
          "type": "boolean",
          "default": false
        },
        "answer": {
          "description": "Přesná posloupnost písmen souvislé tajenky.",
          "type": "string",
          "pattern": "^[A-ZÁÄČĎÉĚÍŇÓÔÖŘŠŤÚŮÜÝŽ]+$"
        },
        "start": {
          "description": "Souřadnice prvního písmene souvislé tajenky.",
          "$ref": "#/$defs/coordinate"
        },
        "direction": {
          "description": "Směr souvislé tajenky od prvního písmene.",
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "legend": {
          "description": "Volitelný text legendy; při vynechání se použije Tajenka.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "default": "Tajenka"
        },
        "parts": {
          "description": "Souvislé bloky jedné tajenky v pořadí čtení.",
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/secretPart"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "cells"
              }
            }
          },
          "then": {
            "required": [
              "cells"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "answer"
                  ]
                },
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "direction"
                  ]
                },
                {
                  "required": [
                    "legend"
                  ]
                },
                {
                  "required": [
                    "parts"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "word"
              }
            }
          },
          "then": {
            "required": [
              "answer",
              "start",
              "direction"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cells"
                  ]
                },
                {
                  "required": [
                    "arrows"
                  ]
                },
                {
                  "required": [
                    "parts"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "parts"
              }
            }
          },
          "then": {
            "required": [
              "parts"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cells"
                  ]
                },
                {
                  "required": [
                    "arrows"
                  ]
                },
                {
                  "required": [
                    "answer"
                  ]
                },
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "direction"
                  ]
                },
                {
                  "required": [
                    "legend"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "secretPart": {
      "description": "Jeden souvislý blok složené tajenky.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cells"
          ],
          "properties": {
            "type": {
              "const": "cells"
            },
            "cells": {
              "description": "Buňky bloku v pořadí čtení.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/coordinate"
              }
            },
            "arrows": {
              "description": "Zda se vyznačí začátek a změny směru bloku.",
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "answer",
            "start",
            "direction"
          ],
          "properties": {
            "type": {
              "const": "word"
            },
            "answer": {
              "description": "Přesná posloupnost písmen bloku.",
              "type": "string",
              "pattern": "^[A-ZÁÄČĎÉĚÍŇÓÔÖŘŠŤÚŮÜÝŽ]+$"
            },
            "start": {
              "description": "Souřadnice prvního písmene bloku.",
              "$ref": "#/$defs/coordinate"
            },
            "direction": {
              "description": "Směr bloku od prvního písmene.",
              "enum": [
                "horizontal",
                "vertical"
              ]
            },
            "legend": {
              "description": "Volitelné přepsání automatického označení části.",
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
